<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MSAL stores its token cache in the shared Microsoft keychain group.
	     Without this entitlement, sign-in fails with MSALErrorDomain -50000. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ESHS.EcoProposal</string>
		<string>$(AppIdentifierPrefix)com.microsoft.adalcache</string>
	</array>
</dict>
</plist>
